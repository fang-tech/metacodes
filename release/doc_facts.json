{
  "schema": "metacodes.doc-facts/v1",
  "facts": [
    {
      "id": "abi_revision",
      "source": {
        "file": "sdk/zig/types.zig",
        "regex": "pub const ABI_REVISION: u32 = (\\d+);"
      },
      "assert_in": [
        {
          "file": "sdk/metask/agentcore.h",
          "regex": "#define METASK_AGENTCORE_ABI_REVISION (\\d+)u"
        },
        {
          "file": "README.md",
          "regex": "AgentCore C ABI v1 revision (\\d+)"
        },
        {
          "file": "ROADMAP.md",
          "regex": "verified at revision (\\d+)"
        },
        {
          "file": "sdk/README.md",
          "regex": "C ABI v1 revision (\\d+)"
        },
        {
          "file": "doc/API.md",
          "regex": "experimental rev (\\d+)"
        },
        {
          "file": "doc/API.md",
          "regex": "ABI revision (\\d+)"
        },
        {
          "file": "doc/AGENTCORE_BINARY_ABI.md",
          "regex": "is \\*\\*ABI v1 revision (\\d+)\\*\\*"
        },
        {
          "file": "doc/AGENTCORE_BINARY_ABI.md",
          "regex": "abi_revision == (\\d+)"
        },
        {
          "file": "doc/AGENTCORE_BINARY_ABI.md",
          "regex": "\\| `abi_revision` \\| exactly (\\d+) \\|"
        },
        {
          "file": "doc/LIB_API.md",
          "regex": "ABI v1 revision (\\d+)"
        },
        {
          "file": "doc/LIB_API.md",
          "regex": "AgentCore v1 revision (\\d+)"
        },
        {
          "file": "doc/LIB_API.md",
          "regex": "^revision (\\d+) \u53ea\u6709\u4e00\u4e2a"
        },
        {
          "file": "doc/PLUGIN_ARCHITECTURE.md",
          "regex": "AgentCore v1 revision (\\d+)"
        },
        {
          "file": "doc/PLUGIN_ARCHITECTURE.md",
          "regex": "ABI v1 revision (\\d+)"
        },
        {
          "file": "doc/PLUGIN_PROCESS_PROTOCOL.md",
          "regex": "AgentCore ABI revision (\\d+)"
        },
        {
          "file": "doc/PLUGIN_EVALUATION.md",
          "regex": "AgentCore v1 revision (\\d+)\u3001CLI"
        }
      ]
    },
    {
      "id": "cli_version",
      "source": {
        "file": "build.zig.zon",
        "regex": "\\.version = \"([^\"]+)\""
      },
      "assert_in": [
        {
          "file": "src/version.zig",
          "regex": "pub const semver = \"([^\"]+)\";"
        }
      ]
    },
    {
      "id": "tinykg_version",
      "source": {
        "file": "deps/tinykg.json",
        "json": "tinykg_version"
      },
      "assert_in": [
        {
          "file": "doc/TINYKG_INTEGRATION.md",
          "regex": "TinyKG version ([0-9.]+) for both roles"
        },
        {
          "file": "doc/TINYKG_INTEGRATION.md",
          "regex": "`tinykg ([0-9.]+)` marker"
        },
        {
          "file": "doc/TINYKG_INTEGRATION.md",
          "regex": "`tinykgd ([0-9.]+)` for a daemon"
        },
        {
          "file": "THIRD_PARTY_NOTICES.md",
          "regex": "\\| TinyKG ([0-9.]+) \\|"
        }
      ]
    },
    {
      "id": "ripgrep_version",
      "source": {
        "file": "vendor/ripgrep/manifest.json",
        "json": "upstream_release"
      },
      "assert_in": [
        {
          "file": "THIRD_PARTY_NOTICES.md",
          "regex": "\\| ripgrep ([0-9.]+) \\|"
        }
      ]
    },
    {
      "id": "mcp_startup_timeout_seconds",
      "source": {
        "file": "src/mcp/config.zig",
        "regex": "pub const DEFAULT_STARTUP_TIMEOUT_MS: u32 = (\\d+)_000;"
      },
      "assert_in": [
        {
          "file": "doc/SKILLS_AND_MCP.md",
          "regex": "The handshake has (\\d+) s by default"
        }
      ]
    },
    {
      "id": "mcp_codex_tool_timeout_seconds",
      "source": {
        "file": "src/mcp/config.zig",
        "regex": "pub const CODEX_TOOL_TIMEOUT_MS: u32 = (\\d+)_000;"
      },
      "assert_in": [
        {
          "file": "doc/SKILLS_AND_MCP.md",
          "regex": "Codex entries default to (\\d+) s"
        }
      ]
    },
    {
      "id": "skill_listing_description_bytes",
      "source": {
        "file": "src/skills/runtime/model_tool.zig",
        "regex": "pub const LISTING_MAX_DESCRIPTION_BYTES: usize = (\\d+);"
      },
      "assert_in": [
        {
          "file": "doc/SKILLS_AND_MCP.md",
          "regex": "capped at (\\d+)\\s+bytes per Skill"
        }
      ]
    },
    {
      "id": "skill_listing_budget_kib",
      "source": {
        "file": "src/core/system_prompt.zig",
        "regex": "pub const SKILL_LISTING_BUDGET_BYTES: usize = (\\d+) \\* 1024;"
      },
      "assert_in": [
        {
          "file": "doc/SKILLS_AND_MCP.md",
          "regex": "past a (\\d+) KiB total"
        }
      ]
    },
    {
      "id": "skill_discovery_depth",
      "source": {
        "file": "src/skills/runtime/catalog.zig",
        "regex": "pub const COMPAT_MAX_DISCOVERY_DEPTH: usize = (\\d+);"
      },
      "assert_in": [
        {
          "file": "doc/SKILLS_AND_MCP.md",
          "regex": "found up to (\\d+) directory levels"
        }
      ]
    }
  ]
}
